# ---- Server ----
NODE_ENV=development
PORT=5000
# Number of reverse proxies in front of the app (0 = none). Needed for correct client IPs / rate limiting.
TRUST_PROXY=0

# ---- Database ----
MONGODB_URL=mongodb://127.0.0.1:27017/rose

# ---- Auth ----
# Must be a long random string (>= 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRE_IN=1h
BCRYPT_ROUNDS=12

# ---- CORS ----
# Comma-separated list of allowed frontend origins (required in production)
CLIENT_URL=http://localhost:4200

# ---- First admin (used ONLY by `npm run seed:admin`) ----
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
